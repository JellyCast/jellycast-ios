    },
    "Open JellyCast to update": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open JellyCast om bij te werken"
          }
        }
      }
    },
    "Play or pause on the TV": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Afspelen of pauzeren op de tv"
          }
