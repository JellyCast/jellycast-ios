{
  "sourceLanguage": "en",
  "strings": {
    "Addresses": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Adressen"
          }
        }
      }
    },
    "In use": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "In gebruik"
          }
        }
      }
    },
    "Add address": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Adres toevoegen"
          }
        }
      }
    },
    "Add": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toevoegen"
          }
        }
      }
    },
    "JellyCast uses the first address from the top that answers. Tap Edit to change the order.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "JellyCast gebruikt het eerste adres van boven dat antwoordt. Tik op Wijzig om de volgorde te veranderen."
          }
        }
      }
    },
    "Add another address of %@, for example over your VPN. You stay signed in.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg nog een adres van %@ toe, bijvoorbeeld via je VPN. Je blijft ingelogd."
          }
        }
      }
    },
    "For example 10.8.0.1:8096": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bijvoorbeeld 10.8.0.1:8096"
          }
        }
      }
    },
    "The server doesn't answer on this address right now.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De server antwoordt nu niet op dit adres."
          }
        }
      }
    },
    "This address is already in the list.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit adres staat al in de lijst."
          }
        }
      }
    },
    "This address leads to another server: %@.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit adres hoort bij een andere server: %@."
          }
        }
      }
    },
    "Next episodes are on this device": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De volgende afleveringen staan op dit apparaat"
          }
        }
      }
    },
    "Download next %lld": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Download volgende %lld"
          }
        }
      }
    },
    "Download %lld episodes": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Download %lld episode"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Download %lld episodes"
                }
              }
            }
          }
        },
        "nl": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Download %lld aflevering"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Download %lld afleveringen"
                }
              }
            }
          }
        }
      }
    },
    "Only %lld of %lld fit on this device.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er passen er maar %1$lld van de %2$lld op dit apparaat."
          }
        }
      }
    },
    "about %@": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "ongeveer %@"
          }
        }
      }
    },
    "Remove watched downloads": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gekeken downloads verwijderen"
          }
        }
      }
    },
    "Keep series ahead": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Series bijhouden"
          }
        }
      }
    },
    "Watched downloads go a day after you watched them. A series you downloaded with Download next keeps its next %lld episodes on this device: at home, the next one downloads once you watch one.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gekeken downloads verdwijnen een dag nadat je ze keek. Een serie die je met Download volgende hebt gedownload, houdt de volgende %lld afleveringen op dit apparaat: thuis wordt de volgende gedownload zodra je er een kijkt."
          }
        }
      }
    },
    "Not downloaded": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niet gedownload"
          }
        }
      }
    },
    "What you see is from your last visit; only your downloads play until the server answers.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wat je ziet komt van je vorige bezoek; tot de server antwoordt spelen alleen je downloads."
          }
        }
      }
    },
    "This app opens until %@": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze app opent tot %@"
          }
        }
      }
    },
    "Reinstall it from the Mac before you travel, or your downloads won't open.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Installeer hem opnieuw vanaf de Mac voor je op reis gaat, anders openen je downloads niet."
          }
        }
      }
    },
