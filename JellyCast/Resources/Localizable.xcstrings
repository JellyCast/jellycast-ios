    "Set in the player, under Audio and subtitles, while the device plays. It applies whenever that device plays again.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stel je in de speler in, onder Audio en ondertitels, terwijl het apparaat speelt. Het geldt elke keer dat dat apparaat weer speelt."
          }
        }
      }
    },
